{
  "name": "isobar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A quiet, editorial weather dashboard. React, Hono, SQLite.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@tanstack/react-query": "^5.105.0",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "storybook": "^10.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
